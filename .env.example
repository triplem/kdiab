# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production, replace ALL values with strong secrets before any deployment.

POSTGRES_PASSWORD=devpassword
KEYCLOAK_ADMIN_PASSWORD=devpassword
# kdiab-users M2M client secret. Injected into Keycloak dev container at startup.
# NOTE: the realm JSON imports with placeholder "change-me-in-production"; rotate via
# Keycloak Admin API before any production deploy (see config/keycloak-realm.README.md).
KEYCLOAK_USERS_SERVICE_SECRET=change-me-in-production

# Per-service database credentials (least-privilege roles created by 01-init-databases.sh).
# Each service connects only to its own database with DML-only access (no DDL).
# Replace with strong, unique passwords in production.
MEASURES_DB_PASSWORD=kdiab_measures_devpassword
PROFILES_DB_PASSWORD=kdiab_profiles_devpassword
TREATMENTS_DB_PASSWORD=kdiab_treatments_devpassword
CARBS_DB_PASSWORD=kdiab_carbs_devpassword
USERS_DB_PASSWORD=kdiab_users_devpassword

# Optional overrides (defaults shown)
# POSTGRES_USER=postgres
# KEYCLOAK_ADMIN=admin
# KC_TRACING_ENABLED=false   # set to true + configure OTEL_EXPORTER_OTLP_ENDPOINT to enable Keycloak tracing

# Optional services (kdiab-nightscout + kdiab-carbs food database).
# These services are disabled by default. To enable, start with:
#   ./podman-up.sh --optional --build
# or manually:
#   VITE_FOOD_DATABASE_ENABLED=true COMPOSE_PROFILES=optional docker compose up --build
# When enabled, VITE_FOOD_DATABASE_ENABLED=true is set automatically by podman-up.sh --optional.
# VITE_FOOD_DATABASE_ENABLED=true
