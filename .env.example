# Copy this file to .env and set real values before running docker compose up.
# .env is gitignored — never commit secrets to version control.

# PostgreSQL password (used by all backends, Liquibase, and the seed container)
POSTGRES_PASSWORD=changeme

# Keycloak admin credentials
KEYCLOAK_ADMIN_PASSWORD=changeme

# Optional overrides (defaults shown)
# POSTGRES_USER=postgres
# KEYCLOAK_ADMIN=admin
