{
  "branches": [
    "main",
    {"name": "*/*", "prerelease": true}
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/github", {
      "assets": [
        {"path": "backend-image.tar", "label": "Backend Docker Image"},
        {"path": "frontend-image.tar", "label": "Frontend Docker Image"}
      ]
    }]
  ]
}
