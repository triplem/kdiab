{
  "enabledPlugins": {
    "kotlin-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(grep*)",
      "Bash(find*)",
      "Bash(wc*)",
      "Bash(sort*)",
      "Bash(uniq*)",

      "Bash(git *)",

      "Bash(gh pr*)",
      "Bash(gh issue*)",
      "Bash(gh run*)",
      "Bash(gh release*)",
      "Bash(gh repo*)",
      "Bash(gh api*)",

      "Bash(bd *)",

      "Bash(./build.sh*)",
      "Bash(./gradlew*)",
      "Bash(npm*)",
      "Bash(npx*)",
      "Bash(node*)",

      "Bash(docker compose*)",
      "Bash(docker-compose*)",
      "Bash(docker images*)",
      "Bash(docker ps*)",
      "Bash(docker build*)",
      "Bash(docker rmi*)",
      "Bash(docker inspect*)",
      "Bash(docker logs*)",

      "Bash(podman compose*)",
      "Bash(podman images*)",
      "Bash(podman ps*)",
      "Bash(podman build*)",
      "Bash(podman rmi*)",
      "Bash(podman inspect*)",
      "Bash(podman logs*)",
      "Bash(./manage-podman.sh*)",

      "Bash(asciidoctor*)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
