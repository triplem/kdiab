{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "kdiab-ui-image.tar",
            "label": "Frontend Docker Image"
          },
          {
            "path": "bom.json",
            "label": "Frontend SBOM (CycloneDX)"
          }
        ]
      }
    ]
  ]
}
